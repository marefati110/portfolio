# Required: your OpenAI API key (never commit the real one; put it in .env.local)
OPENAI_API_KEY=
# Optional: model name (default: gpt-4.1-mini)
OPENAI_MODEL=
# Optional: OpenAI-compatible endpoint, e.g. a proxy (default: https://api.openai.com/v1)
OPENAI_BASE_URL=

# Optional: Google Search Console verification token (read at build time)
GOOGLE_SITE_VERIFICATION=
